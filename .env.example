# --- دیتابیس ---
# برای توسعه SQLite کافی است. برای انتشار واقعی PostgreSQL پیشنهاد می‌شود
# (provider را در prisma/schema.prisma به postgresql تغییر دهید).
DATABASE_URL="file:./dev.db"

# --- نشست کاربر ---
# یک رشته تصادفی بلند (حداقل ۳۲ کاراکتر)
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# --- پیامک (کد ورود) ---
# اگر خالی باشد، در حالت توسعه کد ورود در کنسول سرور و روی صفحه نمایش داده می‌شود.
KAVENEGAR_API_KEY=""
KAVENEGAR_TEMPLATE="verify"

# --- چت‌بات (هر سرویس سازگار با OpenAI Chat Completions) ---
# آدرس پایه API، کلید و نام مدل را از سرویس‌دهنده‌ای که به‌طور قانونی
# برایتان در دسترس است بگیرید. اگر AI_API_KEY خالی باشد، چت‌بات در حالت نمایشی کار می‌کند.
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
# سقف تعداد پیام روزانه هر دانش‌آموز
AI_DAILY_LIMIT="40"
